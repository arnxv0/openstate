MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=openstate

# ---- Models -------------------------------------------------------------
# Flatkey (sponsor): one OpenAI-compatible key for every model, with failover.
# When set, every model call goes to router.flatkey.ai. Keys start with sk-fk-.
FLATKEY_API_KEY=
# OPENAI_BASE_URL=          # override the router (rarely needed)
# MODEL_ROUTE=openai|flatkey|openai-only   # which route goes first (default openai, Flatkey as fallback)
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_FALLBACK_MODELS=gpt-4.1-mini
# Fallbacks when Flatkey is not set: OpenAI directly, else Gemini, else Groq.
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=openai|gemini|groq
# GROQ_API_KEYS=key1,key2

# ---- Voice and faces ----------------------------------------------------
# Masky (sponsor): a face and a voice for each agent; /api/tts speaks through it.
# Name your Masky avatars after the agents (Mira, Iris, Theo, Nova, Ravi, Sol)
# or pin ids: MASKY_AVATARS=host=<avatarId>,scout=<avatarId>
MASKY_API_KEY=
# MASKY_AVATARS=
# Fallback voice when Masky is not set, and speech-to-text on the phone.
ELEVENLABS_API_KEY=

# ---- Agents talking to each other ---------------------------------------
# BAND (sponsor): register one External Agent per roster key in the BAND UI,
# create a chat room with all of them in it, then:
# BAND_AGENTS=gm=<agentUuid>:<apiKey>,eyes=<uuid>:<key>,ledger=...,scout=...,runner=...,host=...
BAND_AGENTS=
BAND_ROOM_ID=

# ---- Actions ------------------------------------------------------------
# n8n (sponsor): import n8n/*.workflow.json, connect Google Tasks / Slack /
# Calendar / Gmail, activate, then point at the instance's webhook base.
N8N_WEBHOOK_BASE=https://YOUR-INSTANCE.app.n8n.cloud/webhook
# N8N_WEBHOOK_SECRET=
# N8N_WORKFLOWS=shopping=https://.../webhook/custom-path,alert=...
# RocketRide (sponsor): the ops pipeline rocketride/openstate-ops.pipe (calls n8n).
ROCKETRIDE_APIKEY=
# ROCKETRIDE_URI=https://api.rocketride.ai
# ROCKETRIDE_PIPE=rocketride/openstate-ops.pipe
ROCKETRIDE_N8N_URL=
ROCKETRIDE_N8N_KEY=
# Kylon (sponsor, optional): a second route to app tools through its proxy.
# KYLON_API_KEY=pak_...
# KYLON_BASE_URL=https://api.kylon.io

# ---- Research and code execution ----------------------------------------
# Tenki and Celesto (sponsors): disposable VMs where Nova researches the web
# and runs Python over the household data. One is enough; Tenki is preferred.
TENKI_API_KEY=
CELESTO_API_KEY=
# SANDBOX_PROVIDER=tenki|celesto

# ---- MCP bridge ---------------------------------------------------------
# Any sponsor MCP server becomes agent tools (lib/sponsors/mcp.ts). HTTP
# targets take a bearer token from MCP_TOKEN_<NAME>; "stdio:" runs a local
# server with the app's environment (so MASKY_API_KEY, TENKI_API_KEY reach it).
# Nova gets mcp:tenki and mcp:celesto, Ravi gets mcp:n8n, mcp:rocketride, mcp:kylon.
# MCP_SERVERS=rocketride=https://api.rocketride.ai/mcp,tenki=stdio:npx -y @tenkicloud/mcp,n8n=https://YOUR-INSTANCE.app.n8n.cloud/mcp/openstate
# MCP_TOKEN_ROCKETRIDE=rr_...
# MCP_TOKEN_N8N=
# MCP_CALL_TIMEOUT_MS=60000

# ---- Context ------------------------------------------------------------
# Paritok (sponsor): compresses long tool outputs and reports before the model.
PARITOK_API_KEY=
# PARITOK_MIN_CHARS=1500

# ---- Misc ---------------------------------------------------------------
# AGENT_MAX_STEPS=6        # model calls per specialist, tools included
# AUTO_REGISTER=1          # let the detector create places by itself
# NEXT_PUBLIC_TURN_URLS=turn:host:3478,turns:host:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
