{
  "name": "openstate-reminder",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "openstate-reminder", "responseMode": "responseNode", "options": {} },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "start": "={{ $json.body.when_iso }}",
        "end": "={{ $json.body.when_iso }}",
        "additionalFields": {
          "summary": "={{ $json.body.title }}",
          "description": "={{ $json.body.notes ?? 'Set by OPENSTATE' }}"
        }
      },
      "id": "calendar",
      "name": "Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [220, 0]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { \"ok\": true, \"link\": $json.htmlLink } }}", "options": {} },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Google Calendar", "type": "main", "index": 0 }]] },
    "Google Calendar": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
